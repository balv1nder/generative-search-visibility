# Copy to .env and fill in. .env is git-ignored and must NEVER be committed.
# Only variable NAMES belong in this file. Never put a real value here.

# LLM provider API keys — set only the ones you actually use
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Hugging Face token, if the dataset or models require authenticated access
HF_TOKEN=

# Local paths (optional overrides)
DATA_DIR=./data
LLM_CACHE_DIR=./.llm_cache

# Optional local Ollama pilot. Set an installed model tag; no model is bundled or assumed.
GEO_OLLAMA_URL=http://127.0.0.1:11434
GEO_OLLAMA_MODEL=
