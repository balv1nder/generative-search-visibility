# Copy to .env and fill in. .env is git-ignored and must NEVER be committed.
# Only variable NAMES belong in this file. Never put a real value here.

# LLM provider API keys — set only the ones you actually use
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Hugging Face token, if the dataset or models require authenticated access
HF_TOKEN=

# Local paths (optional overrides)
DATA_DIR=./data
LLM_CACHE_DIR=./.llm_cache
